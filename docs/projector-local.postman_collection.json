    {
      "name": "Success - Subscriptions",
      "item": [
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionType\": \"EVENT\",\n  \"basicInfo\": {\n    \"name\": \"Local test subscription {{$timestamp}}\",\n    \"description\": \"Created from Postman local collection\",\n    \"goLiveDate\": \"2026-09-15\"\n  },\n  \"parameters\": [\n    { \"code\": \"EVENT_ID\" },\n    { \"code\": \"EVENT_TRIGGER_TYPE\" },\n    { \"code\": \"EVENT_OCCURRED_AT\" }\n  ],\n  \"triggers\": [\n    { \"code\": \"ORDER_CREATED\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('subscriptionId exists', function () { pm.expect(json.subscriptionId).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('subscriptionId', json.subscriptionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Subscriptions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/subscriptions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns a list', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Subscription By UID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('matches environment id', function () { pm.expect(pm.response.json().subscriptionId).to.eql(pm.environment.get('subscriptionId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch Basic Subscription Data",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basicInfo\": {\n    \"name\": \"Updated local subscription {{$timestamp}}\",\n    \"description\": \"Updated from Postman local collection\",\n    \"goLiveDate\": \"2026-09-20\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('name was updated', function () { pm.expect(pm.response.json().name).to.include('Updated local subscription'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace Triggers",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"triggers\": [\n    { \"code\": \"ORDER_CREATED\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}/triggers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('has trigger selection', function () { pm.expect(pm.response.json().triggers).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace Parameters",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parameters\": [\n    { \"code\": \"EVENT_ID\" },\n    { \"code\": \"EVENT_TRIGGER_TYPE\" },\n    { \"code\": \"EVENT_OCCURRED_AT\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}/parameters"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('parameters were selected', function () { pm.expect(pm.response.json().parameters.map(function (value) { return value.code; })).to.include('EVENT_ID'); });"
                ]
              }
            }
          ]
        }
      ]
