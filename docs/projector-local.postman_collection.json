    {
      "name": "Success - Subscriptions",
      "item": [
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionTypeId\": {{subscriptionTypeId}},\n  \"subscriptionStatusId\": {{subscriptionStatusId}},\n  \"name\": \"Local test subscription {{$timestamp}}\",\n  \"description\": \"Created from Postman local collection\",\n  \"activatedAt\": \"2026-08-14T00:00:00Z\",\n  \"deactivatedAt\": null,\n  \"triggers\": [\n    {\n      \"eventTriggerTypeId\": {{eventTriggerTypeId}},\n      \"parameterDefinitionIds\": [{{parameterDefinitionId1}}, {{parameterDefinitionId2}}, {{parameterDefinitionId3}}]\n    }\n  ],\n  \"deliveryConfig\": {\n    \"deliveryType\": \"WEBHOOK\",\n    \"endpointUrl\": \"http://localhost:9090/events\",\n    \"httpMethod\": \"POST\",\n    \"timeoutSeconds\": 30,\n    \"maxRetryCount\": 3,\n    \"retryBackoffSeconds\": 60\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('subscriptionUid exists', function () { pm.expect(json.subscriptionUid).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('subscriptionUid', json.subscriptionUid);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Subscriptions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/subscriptions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns a list', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Subscription By UID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionUid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('matches environment uid', function () { pm.expect(pm.response.json().subscriptionUid).to.eql(pm.environment.get('subscriptionUid')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch Basic Subscription Data",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated local subscription {{$timestamp}}\",\n  \"description\": \"Updated from Postman local collection\",\n  \"activatedAt\": \"2026-08-15T00:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionUid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('name was updated', function () { pm.expect(pm.response.json().name).to.include('Updated local subscription'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace Triggers",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventTriggerTypeIds\": [{{eventTriggerTypeId}}]\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionUid}}/triggers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('has trigger selection', function () { pm.expect(pm.response.json().triggers).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace Parameters",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Email",
                "value": "{{actorEmail}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parameters\": [\n    {\n      \"eventTriggerTypeId\": {{eventTriggerTypeId}},\n      \"parameterDefinitionIds\": [{{parameterDefinitionId1}}, {{parameterDefinitionId2}}, {{parameterDefinitionId3}}]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionUid}}/parameters"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('parameters were selected', function () { pm.expect(pm.response.json().triggers[0].parameterDefinitionIds).to.include(Number(pm.environment.get('parameterDefinitionId1'))); });"
                ]
              }
            }
          ]
        }
      ]
